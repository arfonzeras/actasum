{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tallylog/statement/v0.1",
  "title": "Tally-sheet statement",
  "description": "Counts recorded on one polling station's tally sheet. Draft v0.1.",
  "type": "object",
  "required": ["spec", "profile", "election", "station", "constituency", "counts"],
  "additionalProperties": false,
  "properties": {
    "spec": { "const": "tallylog/statement/v0.1" },
    "profile": { "type": "string", "minLength": 1 },
    "election": { "type": "string", "minLength": 1 },
    "station": { "type": "string", "minLength": 1 },
    "constituency": { "type": "string", "minLength": 1 },
    "unit": { "enum": ["station", "aggregate"] },
    "counts": {
      "type": "object",
      "required": ["blank", "null", "candidatures"],
      "additionalProperties": false,
      "properties": {
        "registered": { "type": "integer", "minimum": 0 },
        "blank": { "type": "integer", "minimum": 0 },
        "null": { "type": "integer", "minimum": 0 },
        "candidature_total": { "type": "integer", "minimum": 0 },
        "candidatures": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "evidence": { "type": "object" },
    "extra": { "type": "object" }
  }
}
