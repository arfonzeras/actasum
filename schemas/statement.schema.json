{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "actasum/statement/v0.1",
  "title": "Tally-sheet statement",
  "description": "Counts recorded on one polling station's tally sheet. Draft v0.1.",
  "type": "object",
  "required": [
    "spec",
    "profile",
    "election",
    "station",
    "constituency",
    "counts"
  ],
  "additionalProperties": false,
  "properties": {
    "spec": {
      "const": "actasum/statement/v0.1"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "election": {
      "type": "string",
      "minLength": 1
    },
    "station": {
      "type": "string",
      "minLength": 1
    },
    "constituency": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "enum": [
        "station",
        "aggregate"
      ]
    },
    "stage": {
      "enum": [
        "count",
        "canvass",
        "ruling",
        "rerun"
      ]
    },
    "supersedes": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "required": [
        "candidatures"
      ],
      "additionalProperties": false,
      "properties": {
        "registered": {
          "type": "integer",
          "minimum": 0
        },
        "blank": {
          "type": "integer",
          "minimum": 0
        },
        "null": {
          "type": "integer",
          "minimum": 0
        },
        "candidature_total": {
          "type": "integer",
          "minimum": 0
        },
        "candidatures": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "other": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "unread": {
          "description": "Figures of the tally sheet that could not be read: item -> reason. An item is blank, null, candidature:<code> or other:<category>, and carries no value elsewhere in counts. blank and null are required unless listed here or in not_on_sheet.",
          "type": "object",
          "propertyNames": {
            "pattern": "^(blank|null|candidature:.+|other:.+)$"
          },
          "additionalProperties": {
            "enum": [
              "illegible",
              "empty"
            ]
          }
        },
        "not_on_sheet": {
          "description": "Figures the tally sheet does not have at all: item -> reason. Same shape and item names as unread. An item is in at most one of unread and not_on_sheet, and carries no value elsewhere in counts.",
          "type": "object",
          "propertyNames": {
            "pattern": "^(blank|null|candidature:.+|other:.+)$"
          },
          "additionalProperties": {
            "enum": [
              "no-field"
            ]
          }
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "blank"
              ]
            },
            {
              "properties": {
                "unread": {
                  "required": [
                    "blank"
                  ]
                }
              },
              "required": [
                "unread"
              ]
            },
            {
              "properties": {
                "not_on_sheet": {
                  "required": [
                    "blank"
                  ]
                }
              },
              "required": [
                "not_on_sheet"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "null"
              ]
            },
            {
              "properties": {
                "unread": {
                  "required": [
                    "null"
                  ]
                }
              },
              "required": [
                "unread"
              ]
            },
            {
              "properties": {
                "not_on_sheet": {
                  "required": [
                    "null"
                  ]
                }
              },
              "required": [
                "not_on_sheet"
              ]
            }
          ]
        }
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        }
      }
    },
    "extra": {
      "type": "object"
    }
  }
}
